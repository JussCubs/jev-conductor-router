# Default chain, when JEV_PROVIDER is unset: orbio, then openrouter, then typesafe.
# Providers without a key are skipped. Set JEV_FALLBACK_PROVIDER to limit fallback to one provider.
# JEV_PROVIDER=
# JEV_FALLBACK_PROVIDER=
JEV_MODEL=typesafe/jev-1.13

ORBIO_API_KEY=
# ORBIO_BASE_URL=https://api.orbio.so
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional per-provider model overrides.
# OpenRouter and Orbio receive JEV_MODEL. TypeSafe's native API receives jev-1.13.0
# when JEV_MODEL is the default typesafe/jev-1.13.
# OPENROUTER_JEV_MODEL=
# TYPESAFE_JEV_MODEL=

CONDUCTOR_API_KEY=

# Opt-in discovery inside a Conductor cloud workspace. See src/discover.mjs.
# CONDUCTOR_DISCOVERY_OPT_IN=1
